# e-Gabay PWD — Environment variables for Vercel
# In Vercel: Project > Settings > Environment Variables > Add New.
# Create each key individually, without quotes. Never commit real secrets to GitHub.
# Railway MySQL mapping (use the PUBLIC/TCP connection details, not a private hostname):
#   DB_HOST = Railway public TCP proxy hostname / MYSQLHOST if externally reachable
#   DB_PORT = Railway public TCP proxy port (often NOT 3306)
#   DB_NAME = MYSQLDATABASE
#   DB_USER = MYSQLUSER
#   DB_PASS = MYSQLPASSWORD
# Other managed MySQL hosts: copy the equivalent values from the provider.
DB_HOST=REPLACE_WITH_PUBLIC_MYSQL_HOST
DB_PORT=REPLACE_WITH_PUBLIC_MYSQL_PORT
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USERNAME
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# true if the MySQL endpoint supports TLS; confirm provider settings.
# Set false only for a trusted development connection if TLS is unavailable.
DB_SSL=true

# Generate locally with: openssl rand -hex 32
# This must be a unique unpredictable value of at least 32 characters.
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_SECRET

# FIX for HANDSHAKE_SSL_ERROR when Railway MySQL presents a private CA.
# Get the public ca.pem from your own Railway MySQL service (see RAILWAY_MYSQL_SSL_FIX.md).
# Add one of these Vercel secrets when DB_SSL=true (not both):
# DB_SSL_CA_BASE64=BASE64_OF_TRUSTED_MYSQL_CA_PEM
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----"
# Do not disable certificate verification or set NODE_TLS_REJECT_UNAUTHORIZED=0.
