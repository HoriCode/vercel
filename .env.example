# Configure these in Vercel > Project > Settings > Environment Variables
DB_HOST=your-hosted-mysql-server
DB_PORT=3306
DB_NAME=e_gabay
DB_USER=egabay_app_user
DB_PASS=replace-with-secret
DB_SSL=true
# Generate an unpredictable secret, minimum 32 bytes, e.g. openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
